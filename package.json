{
  "name": "relay-harness",
  "version": "0.1.0",
  "type": "module",
  "description": "Requirement-to-PR harness for the pi coding agent: spec, design, parallel implementation, evidence-gated verification and review by specialist agents, with code-enforced rules and resumable per-feature worktrees.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shankar029/relay.git"
  },
  "homepage": "https://github.com/shankar029/relay#readme",
  "bugs": {
    "url": "https://github.com/shankar029/relay/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "copilot",
    "agents",
    "orchestrator",
    "multi-agent",
    "harness",
    "pull-request",
    "verification"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/harness/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bin": {
    "relay-install-copilot": "scripts/install-copilot.mjs"
  },
  "files": [
    "extensions/harness/index.ts",
    "extensions/harness/run.ts",
    "extensions/harness/watch.ts",
    "skills",
    "agents",
    "lib",
    "scripts",
    "schemas",
    "templates",
    "docs",
    "relay.config.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "install:copilot": "node scripts/install-copilot.mjs",
    "test": "node --test",
    "typecheck": "tsc -p extensions/harness/tsconfig.json --noEmit",
    "check": "npm run validate && npm test && npm run typecheck"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.0.0",
    "typebox": "*",
    "typescript": "^5.6.0"
  }
}
