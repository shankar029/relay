{
  "name": "relay-harness",
  "version": "0.1.0",
  "type": "module",
  "description": "Relay: orchestrator + specialist-agent harness from requirement to PR",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "copilot",
    "agents",
    "orchestrator"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions/harness/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "bin": {
    "relay-install-copilot": "scripts/install-copilot.mjs"
  },
  "files": [
    "extensions/harness/index.ts",
    "extensions/harness/run.ts",
    "skills",
    "agents",
    "lib",
    "scripts",
    "schemas",
    "templates",
    "docs",
    "relay.config.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "install:copilot": "node scripts/install-copilot.mjs",
    "test": "node --test test/",
    "typecheck": "tsc -p extensions/harness/tsconfig.json --noEmit",
    "check": "npm run validate && npm test && npm run typecheck"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^22.0.0",
    "typebox": "*",
    "typescript": "^5.6.0"
  }
}
