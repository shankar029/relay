{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relay plan.json",
  "type": "object",
  "required": ["contracts", "slices", "order", "independence"],
  "additionalProperties": false,
  "properties": {
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "pinned", "location"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "pinned": { "type": "boolean" },
          "location": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "repos": { "type": "array", "items": { "type": "string" }, "description": "workspace (multi-repo) plans: repos touched by the slices" },
    "slices": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/slice" } },
    "order": { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 1, "items": { "type": "string" } } },
    "independence": {
      "type": "object",
      "required": ["parallelizable", "justification"],
      "additionalProperties": false,
      "properties": { "parallelizable": { "type": "boolean" }, "justification": { "type": "string" } }
    }
  },
  "definitions": {
    "slice": {
      "type": "object",
      "required": ["id", "title", "features", "files", "dependsOn"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "repo": { "type": "string", "description": "workspace plans: the single repo this slice changes; files.own/tests globs are then prefixed with it" },
        "title": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "files": {
          "type": "object",
          "required": ["own"],
          "additionalProperties": false,
          "properties": {
            "own": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "read": { "type": "array", "items": { "type": "string" } }
          }
        },
        "tests": { "type": "array", "items": { "type": "string" } },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "contracts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
