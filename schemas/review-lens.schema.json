{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relay review lens report (reports/review-<lens>.json)",
  "type": "object",
  "required": ["lens", "findings"],
  "additionalProperties": false,
  "properties": {
    "lens": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "citation", "title", "rationale", "fix"],
        "additionalProperties": false,
        "properties": {
          "severity": { "enum": ["blocker", "major", "minor"] },
          "citation": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "fix": { "type": "string" }
        }
      }
    }
  }
}
