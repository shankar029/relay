{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relay document review lens report (reports/docreview-<doc>-<lens>.json)",
  "type": "object",
  "required": ["doc", "lens", "findings"],
  "additionalProperties": false,
  "properties": {
    "doc": { "enum": ["spec", "design"] },
    "lens": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "paraphrase": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "scope", "title", "rationale", "recommendation"],
        "additionalProperties": false,
        "properties": {
          "severity": { "enum": ["blocker", "major", "minor"] },
          "scope": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "recommendation": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
