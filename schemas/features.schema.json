{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Relay features.json",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/item" } }
  },
  "definitions": {
    "item": {
      "type": "object",
      "required": ["name", "title", "description", "scenarios", "passes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/scenario" } },
        "passes": { "type": "boolean" }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["name", "steps", "passes"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "passes": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
